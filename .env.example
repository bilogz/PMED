# Supabase / PostgreSQL configuration
# Option 1 (recommended): full connection string
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Option 2: separate Supabase variables (used if DATABASE_URL is not set)
SUPABASE_PROJECT_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-an-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-service-role-key
SUPABASE_DB_HOST=db.YOUR-PROJECT.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=replace-with-the-database-password
SUPABASE_DB_SSLMODE=require

# Vite and local proxy defaults used by the current app.
VITE_BACKEND_API_BASE_URL=
